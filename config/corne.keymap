#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>
#include "ergol.h"

#define BASE 0
#define NAV 1
#define NUM_EDIT 2
#define FUNCTION 3
#define MOUSE 4
#define SYSTEM 5

/ {
        chosen {
                zmk,physical-layout = &foostan_corne_5col_layout;
        };

        behaviors {
                hrm: home_row_mod {
                        compatible = "zmk,behavior-hold-tap";
                        #binding-cells = <2>;
                        flavor = "tap-preferred";
                        require-prior-idle-ms = <150>;
                        tapping-term-ms = <200>;
                        bindings = <&kp>, <&kp>;
                        hold-trigger-on-release;
                };

                hml: home_row_mod_left {
                        compatible = "zmk,behavior-hold-tap";
                        #binding-cells = <2>;
                        flavor = "balanced";
                        require-prior-idle-ms = <150>;
                        tapping-term-ms = <200>;
                        quick-tap-ms = <175>;
                        bindings = <&kp>, <&kp>;
                        // Right-hand positions
                        hold-trigger-key-positions = <
                                5 6 7 8 9
                                15 16 17 18 19
                                25 26 27 28 29
                                33 34 35
                        >;
                        hold-trigger-on-release;
                };
                hmr: home_row_mod_right {
                        compatible = "zmk,behavior-hold-tap";
                        #binding-cells = <2>;
                        flavor = "balanced";
                        require-prior-idle-ms = <150>;
                        tapping-term-ms = <200>;
                        quick-tap-ms = <175>;
                        bindings = <&kp>, <&kp>;
                        // Left-hand positions
                        hold-trigger-key-positions = <
                                0 1 2 3 4
                                10 11 12 13 14
                                20 21 22 23 24
                                30 31 32
                        >;
                        hold-trigger-on-release;
                };

                tkl: thumb_keys_left {
                        compatible = "zmk,behavior-hold-tap";
                        #binding-cells = <2>;
                        flavor = "balanced";
                        require-prior-idle-ms = <150>;
                        tapping-term-ms = <150>;
                        bindings = <&mo>, <&kp>;
                        // Right-hand positions
                        hold-trigger-key-positions = <
                                5 6 7 8 9
                                15 16 17 18 19
                                25 26 27 28 29
                                33 34 35
                        >;
                        hold-trigger-on-release;
                };
                tkr: thumb_keys_right {
                        compatible = "zmk,behavior-hold-tap";
                        #binding-cells = <2>;
                        flavor = "balanced";
                        require-prior-idle-ms = <150>;
                        tapping-term-ms = <150>;
                        bindings = <&mo>, <&kp>;
                        // Left-hand positions
                        hold-trigger-key-positions = <
                                0 1 2 3 4
                                10 11 12 13 14
                                20 21 22 23 24
                                30 31 32
                        >;
                        hold-trigger-on-release;
                };
        };

        keymap {
                compatible = "zmk,keymap";

                base_layer {
// -----------------------------------------------------------------------------------------
// |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  |
// |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |
// |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  |
//             | NAV | FUN | MSE |   | NUM | BSP  | ALT |
                        bindings = <
   &kp Q       &kp W       &kp E        &kp R        &kp T   &kp Y &kp U        &kp I        &kp O       &kp P
   &hml LGUI A &hml LALT S &hml LSHFT D &hml LCTRL F &kp G   &kp H &hmr RCTRL J &hmr RSHFT K &hmr RALT L &hmr RGUI SEMI
   &kp Z       &kp X       &kp C        &kp V        &kp B   &kp N &kp M        &kp COMMA    &kp DOT     &kp FSLH
                               &tkl NAV ESC   &tkl FUNCTION SPACE   &tkl MOUSE TAB   &tkr NUM_EDIT RET   &kp BACKSPACE   &kp RALT
                        >;
                };

                nav_layer {
// -----------------------------------------------------------------------------------------
// | NUM | C-T | BAK | FWD |     |   | HOME | PGDN | PGUP | END  | G-P  |
// | C-A | C-S | S-T | TAB |     |   | LEFT | DOWN |  UP  | RGHT | FUN  |
// | C-Z | C-X | C-C | C-V |     |   | M_L  | M_D  | M_U  | M_R  |      |
//             |     |     |     |   |      | DEL  | ESC  |
                        bindings = <
   &mo NUM_EDIT &kp LC(EL_T) &kp C_AC_BACK &kp C_AC_FORWARD &none   &kp HOME       &kp PG_DN      &kp PG_UP    &kp END         &kp LG(EL_P)
   &kp LC(EL_A) &kp LC(EL_S) &kp LS(TAB)   &kp TAB          &none   &kp LEFT       &kp DOWN       &kp UP       &kp RIGHT       &mo FUNCTION
   &kp LC(EL_Z) &kp LC(EL_X) &kp LC(EL_C)  &kp LC(EL_V)     &none   &msc SCRL_LEFT &msc SCRL_DOWN &msc SCRL_UP &msc SCRL_RIGHT &none
                                      &trans   &trans   &trans   &trans   &kp DEL   &kp ESC
                        >;
                };

                num_edit_layer {
// -----------------------------------------------------------------------------------------
// |  =  | HOME |  UP  | END | PGUP |   | / | 7 | 8 | 9 | * |
// |  +  | LEFT | DOWN | RGHT| PGDN |   | - | 4 | 5 | 6 | 0 |
// | ODK | C-L  | C-BSP| C-DEL| C-R |   | , | 1 | 2 | 3 | . |
//             | TAB | BSP | RET |   | NUM |   |   |
                        bindings = <
   &kp EL_EQL  &kp HOME     &kp UP            &kp END       &kp PG_UP      &kp EL_SLSH &kp N7 &kp N8 &kp N9 &kp EL_ASTR
   &kp EL_PLUS &kp LEFT     &kp DOWN          &kp RIGHT     &kp PG_DN      &kp EL_MINS &kp N4 &kp N5 &kp N6 &kp N0
   &kp EL_ODK  &kp LC(LEFT) &kp LC(BACKSPACE) &kp LC(DEL)   &kp LC(RIGHT)  &kp EL_COMM &kp N1 &kp N2 &kp N3 &kp EL_DOT
                                        &kp TAB   &kp BACKSPACE   &kp RET   &trans   &none   &none
                        >;
                };

                function_layer {
// -----------------------------------------------------------------------------------------
// | F1  | F2  | F3  | F4  |     |   | PSCRN| BRID| BRIU|VMUTE| VOLU|
// | F5  | F6  | F7  | F8  |     |   |      | CTRL| SHFT| ALT | GUI |
// | F9  | F10 | F11 | F12 |     |   |      | PREV| PP  | NEXT|     |
//             | S-ALT | SPC |   |   |      | BSP | SYS |
                        bindings = <
   &kp F1 &kp F2  &kp F3  &kp F4  &none   &kp PSCRN &kp C_BRI_DN &kp C_BRI_UP &hrm C_MUTE C_VOL_DN &kp C_VOL_UP
   &kp F5 &kp F6  &kp F7  &kp F8  &none   &none     &kp LCTRL    &kp LSHFT    &kp LALT     &kp LGUI
   &kp F9 &kp F10 &kp F11 &kp F12 &none   &none     &kp C_PREV   &kp C_PP     &kp C_NEXT   &none
                               &sk RALT   &kp SPACE   &trans   &trans   &kp BACKSPACE   &mo SYSTEM
                        >;
                };

                mouse_layer {
// -----------------------------------------------------------------------------------------
// |     |     |     |     |     |   |     | LCLK| MCLK| RCLK|     |
// |     |     |     |     |     |   | M_L | M_D | M_U | M_R |     |
// |     |     |     |     |     |   | S_L | S_D | S_U | S_R |     |
//             | DEL |     |     |   |     |     | ESC |
                        bindings = <
   &none &none &none &none &none   &none          &mkp LCLK      &mkp MCLK    &mkp RCLK       &none
   &none &none &none &none &none   &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_UP &mmv MOVE_RIGHT &none
   &none &none &none &none &none   &msc SCRL_LEFT &msc SCRL_DOWN &msc SCRL_UP &msc SCRL_RIGHT &none
                              &kp DEL   &trans   &trans   &trans   &trans   &kp ESC
                        >;
                };

                system_layer {
// -----------------------------------------------------------------------------------------
// | BT1 | BT2 | BT3 | BT4 | BT5 |   |     |     |     |     |     |
// |     |     |     |     |     |   |     | PRV | NXT |     |     |
// | CLR | ALL |     |     |     |   |     |     |     |     |     |
//             |     |     |     |   |     |     |     |
                        bindings = <
   &bt BT_SEL 0 &bt BT_SEL 1   &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4   &none &none      &none      &none &none
   &none        &none          &none        &none        &none          &none &bt BT_PRV &bt BT_NXT &none &none
   &bt BT_CLR   &bt BT_CLR_ALL &none        &none        &none          &none &none      &none      &none &none
                                             &none   &none   &none   &none   &none   &none
                        >;
                };
        };
};
