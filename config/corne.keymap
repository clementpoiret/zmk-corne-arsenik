#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/modifiers.h>
#include <dt-bindings/zmk/pointing.h>
#include "ergol.h"

#define BASE 0
#define NAV 1
#define NUM_EDIT 2
#define FUNCTION 3
#define MOUSE 4
#define SYSTEM 5
#define MOUSE_SLOW 6
#define MOUSE_FAST 7

&sk {
        release-after-ms = <1000>;
};

/ {
        chosen {
                zmk,physical-layout = &foostan_corne_5col_layout;
        };

        behaviors {
                aspc: ascii_space {
                        compatible = "zmk,behavior-mod-morph";
                        #binding-cells = <0>;
                        bindings = <&kp SPACE>, <&kp SPACE>;
                        mods = <(MOD_LSFT | MOD_RSFT | MOD_RALT)>;
                };

                hml: home_row_mod_left {
                        compatible = "zmk,behavior-hold-tap";
                        #binding-cells = <2>;
                        flavor = "balanced";
                        require-prior-idle-ms = <150>;
                        tapping-term-ms = <200>;
                        quick-tap-ms = <175>;
                        bindings = <&kp>, <&kp>;
                        // Right-hand positions
                        hold-trigger-key-positions = <
                                5 6 7 8 9
                                15 16 17 18 19
                                25 26 27 28 29
                                33 34 35
                        >;
                        hold-trigger-on-release;
                };
                hmr: home_row_mod_right {
                        compatible = "zmk,behavior-hold-tap";
                        #binding-cells = <2>;
                        flavor = "balanced";
                        require-prior-idle-ms = <150>;
                        tapping-term-ms = <200>;
                        quick-tap-ms = <175>;
                        bindings = <&kp>, <&kp>;
                        // Left-hand positions
                        hold-trigger-key-positions = <
                                0 1 2 3 4
                                10 11 12 13 14
                                20 21 22 23 24
                                30 31 32
                        >;
                        hold-trigger-on-release;
                };

                tl: thumb_layer {
                        compatible = "zmk,behavior-hold-tap";
                        #binding-cells = <2>;
                        flavor = "hold-preferred";
                        tapping-term-ms = <150>;
                        bindings = <&mo>, <&kp>;
                };
                sf: space_function {
                        compatible = "zmk,behavior-hold-tap";
                        #binding-cells = <2>;
                        flavor = "balanced";
                        tapping-term-ms = <150>;
                        quick-tap-ms = <175>;
                        bindings = <&mo>, <&kp>;
                };
        };

        keymap {
                compatible = "zmk,keymap";

                base_layer {
// -----------------------------------------------------------------------------------------
// |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  |
// |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |
// |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  |
//             | NAV | FUN | MSE |   | NUM | BSP  | ALT |
                        bindings = <
   &kp Q       &kp W       &kp E        &kp R        &kp T   &kp Y &kp U        &kp I        &kp O       &kp P
   &hml LGUI A &hml LALT S &hml LSHFT D &hml LCTRL F &kp G   &kp H &hmr RCTRL J &hmr RSHFT K &hmr RALT L &hmr RGUI SEMI
   &kp Z       &kp X       &kp C        &kp V        &kp B   &kp N &kp M        &kp COMMA    &kp DOT     &kp FSLH
                               &tl NAV ESC   &sf FUNCTION SPACE   &tl MOUSE TAB   &tl NUM_EDIT RET   &kp BACKSPACE   &kp RALT
                        >;
                };

                nav_layer {
// -----------------------------------------------------------------------------------------
// | C-L | C-R | C-BSP | C-DEL | REP |   | BAK  | HOME | PGDN | PGUP | END  |
// | C-A | C-Z | CS-Z  | C-C   | C-V |   | FWD  | LEFT | DOWN |  UP  | RGHT |
// | CS-L| CS-R| S-HOME| S-END | C-X |   |      | C-ST | C-T  |      |      |
//             |     |     |     |   |      | DEL  | ESC  |
                        bindings = <
   &kp LC(LEFT)     &kp LC(RIGHT)     &kp LC(BACKSPACE) &kp LC(DEL)  &key_repeat   &kp C_AC_BACK    &kp HOME        &kp PG_DN   &kp PG_UP &kp END
   &kp LC(EL_A)     &kp LC(EL_Z)      &kp LC(LS(EL_Z))  &kp LC(EL_C) &kp LC(EL_V) &kp C_AC_FORWARD &kp LEFT        &kp DOWN    &kp UP    &kp RIGHT
   &kp LC(LS(LEFT)) &kp LC(LS(RIGHT)) &kp LS(HOME)      &kp LS(END)  &kp LC(EL_X) &none            &kp LC(LS(TAB)) &kp LC(TAB) &none     &none
                                                     &trans   &trans   &trans   &trans   &kp DEL   &kp ESC
                        >;
                };

                num_edit_layer {
// -----------------------------------------------------------------------------------------
// |  =  | HOME |  UP  | END | PGUP |   | / | 7 | 8 | 9 | * |
// |  +  | LEFT | DOWN | RGHT| PGDN |   | - | 4 | 5 | 6 | 0 |
// | ODK | C-L  | C-BSP| C-DEL| C-R |   | , | 1 | 2 | 3 | . |
//             | TAB | BSP | RET |   | NUM |   |   |
                        bindings = <
   &kp EL_EQL  &kp HOME     &kp UP            &kp END       &kp PG_UP      &kp EL_SLSH &kp N7 &kp N8 &kp N9 &kp EL_ASTR
   &kp EL_PLUS &kp LEFT     &kp DOWN          &kp RIGHT     &kp PG_DN      &kp EL_MINS &kp N4 &kp N5 &kp N6 &kp N0
   &kp EL_ODK  &kp LC(LEFT) &kp LC(BACKSPACE) &kp LC(DEL)   &kp LC(RIGHT)  &kp EL_COMM &kp N1 &kp N2 &kp N3 &kp EL_DOT
                                        &kp TAB   &kp BACKSPACE   &kp RET   &tog NUM_EDIT   &none   &none
                        >;
                };

                function_layer {
// -----------------------------------------------------------------------------------------
// | F1  | F2  | F3  | F4  |     |   | PSCRN| BRID| BRIU| MUTE| ASCII |
// | F5  | F6  | F7  | F8  |     |   | CTRL | SHFT| ALT | GUI |       |
// | F9  | F10 | F11 | F12 |     |   | PREV | PP  | NEXT| VOLD| VOLU  |
//             | S-ALT | SPC |   |   | S-SHFT | BSP | SYS |
                        bindings = <
   &kp F1 &kp F2  &kp F3  &kp F4  &none   &kp PSCRN  &kp C_BRI_DN &kp C_BRI_UP &kp C_MUTE   &aspc
   &kp F5 &kp F6  &kp F7  &kp F8  &none   &kp LCTRL  &kp LSHFT    &kp LALT     &kp LGUI     &none
   &kp F9 &kp F10 &kp F11 &kp F12 &none   &kp C_PREV &kp C_PP     &kp C_NEXT   &kp C_VOL_DN &kp C_VOL_UP
                               &sk RALT   &kp SPACE   &none   &sk LSHFT   &kp BACKSPACE   &mo SYSTEM
                        >;
                };

                mouse_layer {
// -----------------------------------------------------------------------------------------
// | SLOW| FAST|     |     |     |   | BACK| S_L | S_D | S_U | S_R |
// | CTRL| SHFT| ALT | GUI |     |   | FWD | M_L | M_D | M_U | M_R |
// | LCLK| RCLK| MCLK|     |     |   |     |     |     |     |     |
//             | EXIT | SPC | UNLOCK |   |     | BSP | ESC |
                        bindings = <
   &mo MOUSE_SLOW &mo MOUSE_FAST &none &none &none   &mkp MB4 &msc SCRL_LEFT &msc SCRL_DOWN &msc SCRL_UP &msc SCRL_RIGHT
   &kp LCTRL      &kp LSHFT       &kp LALT &kp LGUI &none   &mkp MB5 &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_UP &mmv MOVE_RIGHT
   &mkp LCLK      &mkp RCLK       &mkp MCLK &none &none   &none &none &none &none &none
                                      &to BASE   &kp SPACE   &tog MOUSE   &none   &kp BACKSPACE   &kp ESC
                        >;
                };

                system_layer {
// -----------------------------------------------------------------------------------------
// | BT1 | BT2 | BT3 | BT4 | BT5 |   | CAPS| COMP|     |     |     |
// |     |     |     |     |     |   | NUM | PRV | NXT |     | MSE |
// | CLR | ALL |     |     |     |   |     |     |     |     |     |
//             |     |     |     |   |     |     |     |
                        bindings = <
   &bt BT_SEL 0 &bt BT_SEL 1   &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4   &kp CAPSLOCK &kp K_APPLICATION &none &none &none
   &none        &none          &none        &none        &none          &tog NUM_EDIT &bt BT_PRV &bt BT_NXT &none &tog MOUSE
   &bt BT_CLR   &bt BT_CLR_ALL &none        &none        &none          &none &none      &none      &none &none
                                             &none   &none   &none   &none   &none   &none
                        >;
                };

                mouse_slow_layer {
                        bindings = <
   &trans &trans &trans &trans &trans   &trans &msc MOVE_X(-4) &msc MOVE_Y(-4) &msc MOVE_Y(4) &msc MOVE_X(4)
   &trans &trans &trans &trans &trans   &trans &mmv MOVE_X(-200) &mmv MOVE_Y(200) &mmv MOVE_Y(-200) &mmv MOVE_X(200)
   &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans
                                      &trans   &trans   &trans   &trans   &trans   &trans
                        >;
                };

                mouse_fast_layer {
                        bindings = <
   &trans &trans &trans &trans &trans   &trans &msc MOVE_X(-20) &msc MOVE_Y(-20) &msc MOVE_Y(20) &msc MOVE_X(20)
   &trans &trans &trans &trans &trans   &trans &mmv MOVE_X(-1200) &mmv MOVE_Y(1200) &mmv MOVE_Y(-1200) &mmv MOVE_X(1200)
   &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans
                                      &trans   &trans   &trans   &trans   &trans   &trans
                        >;
                };
        };
};
